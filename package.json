{
  "name": "justonehop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "release:check": "tsx scripts/check-release.ts",
    "package:store": "npm run release:check && npm run build && tsx scripts/package-store.ts",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
